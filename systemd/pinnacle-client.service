[Unit]
Description=Pinnacle Client — gRPC daemon for IV&V hardware validation
Documentation=https://github.com/SiliconCentric/Pinnacle-Client
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5 [Service]
Type=simple
User=pinnacle
Group=pinnacle
WorkingDirectory=/var/lib/pinnacle
# Starts BOTH listeners:
# - ClientService (stream path → Server, default port 50051)
# - HalService (SDK/E2E path, default port 50052)
ExecStart=/usr/bin/pinnacle-client
Restart=on-failure
RestartSec=5 # Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pinnacle-client # Hardening
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ReadWritePaths=/var/lib/pinnacle
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes [Install]
WantedBy=multi-user.target
